{
  "name": "next-js-boilerplate",
  "author": "Mark Bekooy",
  "scripts": {
    "generate:seo-content-pages": "node scripts/generate-seo-content-pages.mjs",
    "predev": "pnpm generate:seo-content-pages",
    "prebuild": "pnpm generate:seo-content-pages",
    "prepare": "lefthook install",
    "dev:next": "next dev",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "build-stats": "pnpm generate:seo-content-pages && next analyze",
    "clean": "rimraf .next out coverage",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "check:types": "dotenv -c development -- next typegen && tsc --noEmit --pretty",
    "check:deps": "dotenv -c development -- knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db-server:file": "node scripts/dev.mjs --database-only",
    "db-server:memory": "pglite-server --run \"pnpm db:migrate\"",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:preview": "dotenv -c development -- drizzle-kit push --explain",
    "db:preview:prod": "dotenv -c production -- drizzle-kit push --explain",
    "db:migrate": "dotenv -c development -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -c production -- drizzle-kit migrate",
    "db:studio": "dotenv -c development -- drizzle-kit studio",
    "db:studio:prod": "dotenv -c production -- drizzle-kit studio"
  },
  "dependencies": {
    "@arcjet/next": "^1.15.0",
    "@base-ui/react": "^1.9.0",
    "@clerk/localizations": "^4.24.5",
    "@clerk/nextjs": "^7.9.24",
    "@hookform/resolvers": "^7.0.2",
    "@logtape/logtape": "^2.4.2",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "~16.4.5",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "1.0.0-rc.5",
    "lucide-react": "^1.68.0",
    "next": "~16.4.5",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "posthog-js": "^1.445.4",
    "posthog-node": "^5.61.2",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "svix": "^2.9.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@clerk/eslint-plugin": "0.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@lingual/i18n-check": "^0.9.5",
    "@mdx-js/loader": "^3.1.1",
    "@next/playwright": "16.4.5",
    "@playwright/test": "^1.64.1",
    "@posthog/nextjs-config": "1.12.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-github": "6.1.2",
    "front-matter": "^4.0.2",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "npm-run-all": "^4.1.5",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-plugin-react-doctor": "0.9.22",
    "oxlint-tailwindcss": "1.17.1",
    "postcss": "^8.5.32",
    "postcss-load-config": "^6.0.1",
    "react-scan": "^0.5.7",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "rimraf": "^6.1.4",
    "semantic-release": "^25.0.9",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
